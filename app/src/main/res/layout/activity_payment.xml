<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/fb_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fb_blue"
        android:titleTextColor="@color/white"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtPaymentTotal"
                android:text="Total: 0 DH"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/fb_text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/edtCardName"
                android:hint="Nom sur la carte"
                android:backgroundTint="@color/fb_blue"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/edtCardNumber"
                android:hint="Numéro de carte"
                android:backgroundTint="@color/fb_blue"
                android:inputType="number"
                android:maxLength="16"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/edtCardExpiry"
                android:hint="MM/AA"
                android:backgroundTint="@color/fb_blue"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/edtCardCVV"
                android:hint="CVV"
                android:backgroundTint="@color/fb_blue"
                android:inputType="numberPassword"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnConfirm"
                android:text="Confirmer"
                android:textColor="@color/white"
                android:backgroundTint="@color/fb_blue"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

</LinearLayout>