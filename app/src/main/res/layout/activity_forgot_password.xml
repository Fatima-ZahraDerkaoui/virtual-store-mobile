<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:padding="24dp">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TITLE -->
        <TextView
            android:text="Mot de passe oublié"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- EMAIL -->
        <EditText
            android:id="@+id/emailInput"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edittext_style"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"/>

        <!-- SECOND NAME -->
        <EditText
            android:id="@+id/secondNameInput"
            android:hint="Second Name"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edittext_style"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"/>

        <!-- FAVORITE COLOR -->
        <EditText
            android:id="@+id/favoriteColorInput"
            android:hint="Couleur favorite"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edittext_style"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"/>

        <!-- VERIFY BUTTON -->
        <Button
            android:id="@+id/verifyButton"
            android:text="Vérifier"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/button_blue"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="20dp"/>

        <!-- RESET SECTION -->
        <LinearLayout
            android:id="@+id/resetLayout"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- NEW PASSWORD -->
            <EditText
                android:id="@+id/newPasswordInput"
                android:hint="Nouveau mot de passe"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/edittext_style"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"/>

            <!-- CONFIRM PASSWORD -->
            <EditText
                android:id="@+id/confirmPasswordInput"
                android:hint="Confirmer mot de passe"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/edittext_style"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"/>

            <!-- RESET BUTTON -->
            <Button
                android:id="@+id/resetButton"
                android:text="Réinitialiser le mot de passe"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:background="@drawable/button_blue"
                android:layout_width="match_parent"
                android:layout_height="55dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>