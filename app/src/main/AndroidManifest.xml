<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AR Feature -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VirtualStore">

        <!-- ARCore Metadata -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!-- Activities (Auth & Catalog) -->
        <activity
            android:name=".activities.auth.AdminActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".activities.catalog.CatalogActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.LoginActivity"
            android:exported="false" />

        <!-- Activities (Admin Part) -->
        <activity android:name=".activities.admin.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".activities.admin.ProductListAdminActivity" android:exported="false" />
        <activity android:name=".activities.admin.CategoryListActivity" android:exported="false" />
        <activity android:name=".activities.admin.UserListActivity" android:exported="false" />
        <activity android:name=".activities.admin.OrderListActivity" android:exported="false" />
        <activity android:name=".activities.admin.OrderDetailActivity" android:exported="false" />
        <activity android:name=".activities.admin.StockManagementActivity" android:exported="false" />
        <activity android:name=".activities.admin.AddEditProductActivity" android:exported="false" />

        <!-- Activities (Panier & Historique) -->
        <activity
            android:name=".activities.panier_historique.CartActivity"
            android:exported="false" />
        <activity
            android:name=".activities.panier_historique.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".activities.panier_historique.HistoryActivity"
            android:exported="false" />
        <activity
            android:name=".activities.panier_historique.OrderDetailsActivity"
            android:exported="false" />

        <!-- Launcher Activity -->
        <activity
            android:name=".activities.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>

</manifest>